[Host]
# 每个透明代理路由器 WiFi 一行，IP 填各自路由器管理 IP
# 官方写法是 ssid:名称 = server:IP，冒号后不留空格，否则 SSID 名可能带前导空格导致匹配不到
ssid:WiFi1 = server:10.0.0.1
ssid:WiFi2 = server:10.0.0.2

[Rewrite]

[Script]

[Plugin]
# ── 新增 ──
https://kelee.one/Tool/Loon/Lpx/TelegramRedirect.lpx, enabled=true
https://kelee.one/Tool/Loon/Lpx/AppleWeatherEnhancer.lpx, enabled=false
https://kelee.one/Tool/Loon/Lpx/12306_remove_ads.lpx, enabled=true
https://kelee.one/Tool/Loon/Lpx/DragonRead_remove_ads.lpx, enabled=true
https://gh-proxy.com/https://raw.githubusercontent.com/taiji951906413/fanqie-loon/refs/heads/main/fanqie.plugin, tag=过滤番茄三系广告, enabled=true
# ── 原有 ──
# pin=true 表示把插件固定在列表前部、不参与自动重排（官方示例配置用它保护核心防泄漏插件），与「是否跟随上游更新」无关
https://kelee.one/Tool/Loon/Lpx/Block_HTTPDNS.lpx, pin=true, enabled=true
https://kelee.one/Tool/Loon/Lpx/BlockAdvertisers.lpx, pin=true, enabled=true
https://kelee.one/Tool/Loon/Lpx/QuickSearch.lpx, enabled=true
https://kelee.one/Tool/Loon/Lpx/Prevent_DNS_Leaks.lpx, policy=场景分流, enabled=true
https://kelee.one/Tool/Loon/Lpx/Node_detection_tool.lpx, enabled=true
https://kelee.one/Tool/Loon/Lpx/TestFlightRegionUnlock.lpx, policy=DIRECT, enabled=false
https://kelee.one/Tool/Loon/Lpx/BoxJs.lpx, policy=场景分流, enabled=true
https://kelee.one/Tool/Loon/Lpx/Sub-Store.lpx, policy=场景分流, enabled=true
https://kelee.one/Tool/Loon/Lpx/Script-Hub.lpx, policy=场景分流, enabled=true
# ── Apple 天气增强（iRingo:WeatherKit，两个版本二选一，不要同时启用）──
# Rewrite 版：纯 URL 重写，把 weatherkit.apple.com 的 API 请求转到第三方中转 weatherkit.pages.dev，不需要 token。
# 代价：天气请求（含坐标）会经过该第三方服务，且 pages.dev 需走代理才通；不想依赖别人就关掉它。
https://gh-proxy.com/https://github.com/NSRingo/WeatherKit/raw/main/modules/iRingo.WeatherKit.Rewrite.lpx, enabled=true
# 脚本版：在本地改写响应体，可接彩云 / 和风 / WAQI 数据源；需要在 BoxJs 或插件参数里填 token 才有最佳效果。
# 脚本从 GitHub releases 拉取，需 GitHub 规则命中代理（本配置里 GitHub 走 场景分流）。
# 该 release 资源走 gh-proxy 会返回 520，改用 ghfast.top（sing-box 那边的规则集也用这个镜像）
https://ghfast.top/https://github.com/NSRingo/WeatherKit/releases/latest/download/iRingo.WeatherKit.lpx, enabled=false

[Mitm]
# 番茄插件（fanqie.plugin）里把 MITM 域名写成了 "%APPEND% ..."，Loon 不认这个前缀，
# 这里显式声明一遍，保证插件里的信息流广告改写脚本能真正生效
hostname = *.fqnovel.com,*.snssdk.com,*.zijieapi.com
ca-p12=
ca-passphrase=
skip-server-cert-verify=false
