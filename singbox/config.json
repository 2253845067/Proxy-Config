{
  "$schema": "https://raw.githubusercontent.com/reF1nd/sing-box/reF1nd-testing-next/docs/schema.json",
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "providers": [
    {
      "type": "remote",
      "tag": "airport",
      "url": "https://example.com/your-subscription",
      "path": "providers/airport.txt",
      "exclude": "(?i)(群|邀请|返利|循环|官网|客服|网站|网址|获取|订阅|流量|剩余流量|到期|机场|下次|版本|官址|备用|过期|已用|联系|邮箱|工单|贩卖|通知|倒卖|防止|国内|地址|频道|无法|说明|使用|提示|特别|访问|支持|教程|关注|更新|作者|加入|超时|收藏|福利|失联|USE|USED|TOTAL|EXPIRE|EMAIL|Panel|Channel|Author|Traffic|\\d{4}-\\d{2}-\\d{2}|\\d+G)",
      "http_client": "provider-download",
      "update_interval": "24h"
    }
  ],
  "http_clients": [
    {
      "tag": "provider-download",
      "detour": "direct-dns"
    },
    {
      "tag": "download",
      "detour": "Proxy"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "local"
      },
      {
        "tag": "cn-ali",
        "type": "https",
        "server": "223.5.5.5",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "server_name": "dns.alidns.com"
        },
        "detour": "direct-dns"
      },
      {
        "tag": "cn-tencent",
        "type": "https",
        "server": "1.12.12.12",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "server_name": "doh.pub"
        },
        "detour": "direct-dns"
      },
      {
        "tag": "cn",
        "type": "group",
        "servers": ["cn-ali", "cn-tencent"]
      },
      {
        "tag": "remote-google",
        "type": "https",
        "server": "8.8.8.8",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "server_name": "dns.google"
        },
        "detour": "Proxy"
      },
      {
        "tag": "remote-cloudflare",
        "type": "https",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "server_name": "cloudflare-dns.com"
        },
        "detour": "Proxy"
      },
      {
        "tag": "remote",
        "type": "group",
        "servers": ["remote-google", "remote-cloudflare"]
      }
    ],
    "rules": [
      {
        "domain_suffix": ["lan", "local"],
        "action": "route",
        "server": "local"
      },
      {
        "rule_set": ["Lan", "ChinaDomain", "WeChat", "Bilibili"],
        "action": "route",
        "server": "cn"
      }
    ],
    "final": "remote",
    "strategy": "ipv4_only",
    "optimistic": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 7890,
      "set_system_proxy": false
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "sing-box",
      "address": ["172.19.0.1/30"],
      "auto_route": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "Proxy",
      "outbounds": ["Auto"],
      "providers": ["airport"],
      "default": "Auto"
    },
    {
      "type": "urltest",
      "tag": "Auto",
      "providers": ["airport"],
      "use_all_providers": true,
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50,
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "CN",
      "outbounds": ["direct", "Proxy"],
      "default": "direct"
    },
    {
      "type": "direct",
      "tag": "direct-dns",
      "connect_timeout": "10s"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "cn",
    "rule_set": [
      {
        "tag": "Reject",
        "type": "remote",
        "format": "binary",
        "url": "https://ghfast.top/https://github.com/Repcz/Tool/raw/X/sing-box/Rules/Reject.srs",
        "http_client": "download",
        "update_interval": "1d"
      },
      {
