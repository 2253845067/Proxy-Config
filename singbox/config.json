    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "rule_set": ["Reject", "Ads_AWAvenue"],
        "action": "reject"
      },
      {
        "domain_suffix": ["lan", "local"],
        "outbound": "direct"
      },
      {
        "rule_set": ["Lan", "Direct"],
        "outbound": "direct"
      },
      {
        "network": "udp",
        "port": 443,
        "action": "reject"
      },
      {
        "rule_set": ["WeChat", "Bilibili", "AppleCN", "OneDrive", "DownloadCDN_CN", "ChinaDomain"],
        "outbound": "CN"
      },
      {
        "rule_set": ["AI", "OpenAI", "Telegram", "Twitter", "Facebook", "Instagram", "TikTok", "Reddit", "Google", "Github", "Microsoft", "YouTube", "Netflix", "Disney", "HBO", "PrimeVideo", "Emby", "Spotify", "Bahamut", "Steam", "Epic", "EA", "Blizzard", "Nintendo", "Xbox", "UBI", "Game", "Crypto", "TronLink", "PayPal", "Cloudflare", "DownloadCDN_Global", "AppleServers", "ProxyAll"],
        "outbound": "Proxy"
      },
      {
        "action": "resolve",
        "match_only": true
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "rule_set": ["ChinaIP"],
        "outbound": "CN"
      }
    ],
    "final": "Proxy"
  },
  "experimental": {
